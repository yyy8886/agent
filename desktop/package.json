{
  "name": "my-agent-next-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for My Agent Next",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir",
    "build:backend:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../backend/scripts/build_windows_backend.ps1",
    "dist": "electron-builder",
    "dist:win": "npm run build:backend:win && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.myagentnext.desktop",
    "productName": "My Agent Next",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/my-agent-next-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
